# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Côté serveur uniquement (invitations, Phase 1) — ne jamais exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (liens magiques et invitations)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envoi des invitations par e-mail (facultatif : sinon le lien s'affiche pour être copié)
RESEND_API_KEY=
RESEND_FROM=TNF <organisation@thenewface.io>
